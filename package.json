{
  "name": "n-lams-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --config client/vite.config.ts\" \"tsx watch server/src/server.ts\"",
    "dev:web": "vite --config client/vite.config.ts",
    "dev:api": "tsx watch server/src/server.ts",
    "build": "tsc -b && vite --config client/vite.config.ts build",
    "build:api": "tsc -p server/tsconfig.json",
    "start": "node server/dist/server.js",
    "seed": "tsx server/src/seed.ts",
    "test": "tsx server/src/tests/golden-path.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@hookform/resolvers": "^4.1.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.66.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
